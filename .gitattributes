* text=auto

# Source, docs and scripts keep LF so they work on Linux as well as Windows.
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Visual Studio and Windows launchers use CRLF in the working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.slnx text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
